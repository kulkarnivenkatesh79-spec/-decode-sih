# Copy to server/.env and fill in real values. server/.env is gitignored.

# Port the Express server listens on. Render injects its own PORT at deploy time.
PORT=3000

# Same Atlas connection string used elsewhere in this project (cluster "sih").
# Do NOT commit the real value.
MONGO_URI=

# Database name inside that cluster. Defaults to "sih" if left unset.
MONGO_DB_NAME=sih

# Shared secret n8n already sends on its HTTP Request nodes (Header Auth
# credential). Guards POST /api/escalations/upsert and POST /api/admins/upsert.
N8N_INTERNAL_AUTH_HEADER_NAME=
N8N_INTERNAL_AUTH_HEADER_VALUE=

# Shared secret the dashboard frontend sends on the GET read endpoints. This is
# a static string baked into frontend JS — casual-scraping deterrent only, not
# real auth. Keep it distinct from the n8n secret above.
DASHBOARD_API_AUTH_HEADER_NAME=
DASHBOARD_API_AUTH_HEADER_VALUE=

# Origin(s) allowed via CORS, e.g. https://arogya-dashboard.example.com
# Comma-separated list accepted. Use the dashboard's real deployed origin.
ALLOWED_ORIGIN=

# Base URL of the arogya_escalation_manager n8n workflow, e.g.
# https://your-tenant.app.n8n.cloud — used for the outbound ack webhook call
# behind POST /api/escalations/:case_id/respond.
N8N_ESCALATION_MANAGER_BASE_URL=
